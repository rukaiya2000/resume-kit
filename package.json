{
  "name": "resume-creator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"pnpm --filter @rc/api dev\" \"pnpm --filter @rc/web dev\"",
    "build": "pnpm --filter @rc/web build",
    "test": "vitest run",
    "typecheck": "pnpm -r typecheck",
    "setup": "pnpm install && pnpm --filter @rc/api exec playwright install chromium"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.14.0"
}
