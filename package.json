{
  "name": "resume-creator",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"pnpm --filter @rc/api dev\" \"pnpm --filter @rc/web dev\"",
    "build": "pnpm --filter @rc/web build",
    "test": "vitest run && uv run --directory ai pytest -q",
    "typecheck": "pnpm -r typecheck",
    "setup": "pnpm install && pnpm --filter @rc/api exec playwright install chromium && uv sync --directory ai",
    "setup-vault": "uv run --directory ai server.py --setup-vault",
    "start": "pnpm --filter @rc/web build && SERVE_WEB=1 pnpm --filter @rc/api start",
    "test:e2e": "playwright test",
    "lint:py": "uv run --directory ai ruff check . && uv run --directory ai ruff format --check .",
    "login-item:install": "bash scripts/login-item.sh install",
    "login-item:remove": "bash scripts/login-item.sh remove"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "concurrently": "^10.0.5",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@11.14.0"
}
